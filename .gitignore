# The first commit of every repository should contain this file.
# Everything in the demo exists because this file did not.
.env
.env.*
!.env.example
*.pem
*.key
!*.pub
*.p12
*.pfx
credentials
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
# ...except the deploy roots: the provider version and its checksums are part of
# what was reviewed. Update deliberately with `terraform init -upgrade` in a PR.
!terraform/deploy/*/.terraform.lock.hcl
crash.log
checkov-report/
results.sarif
triage-comment.md
__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store

# SOPS: encrypted files ARE committed on purpose. Plaintext never is.
secrets.yaml
secrets.dec.yaml
*.dec.yaml

# Personal presentation notes and generated scan output: kept on disk, not published.
HANDOFF.md
docs/final/1-RUNBOOK.md
docs/word/
docs/archive/
scripts/highlight_runbook.py
.scan/
