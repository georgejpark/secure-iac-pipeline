<mxfile host="app.diagrams.net" type="device">
  <diagram name="Simple flow" id="Simple-flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1"
                  connect="1" arrows="1" fold="1" page="1" pageScale="1"
                  pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t2" value="&lt;b&gt;One change, from my laptop to production&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="880" height="40" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;1   I change one number&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;production memory: 2 GB  →  3 GB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="310.0" y="100" width="380" height="70" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;2   I commit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;a hook checks for passwords first&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="310.0" y="215" width="380" height="70" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;3   I open a pull request&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;this starts everything else&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="310.0" y="330" width="380" height="70" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;4   It looks for secrets&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;every commit ever made, not just mine&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;strokeWidth=2;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="310.0" y="445" width="380" height="70" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;5   It checks the code&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;unsafe settings. 10 block in dev, 14 in prod&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="310.0" y="560" width="380" height="70" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;6   It writes me a comment&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;plain English: what to fix, and why&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="310.0" y="675" width="380" height="70" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;7   Somebody approves&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;I cannot approve my own work&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EFFE;strokeColor=#6D28D9;strokeWidth=2;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="310.0" y="790" width="380" height="70" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b&gt;8   I merge&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;this is what allows a deployment&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EFFE;strokeColor=#6D28D9;strokeWidth=2;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="310.0" y="905" width="380" height="70" as="geometry"/></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="blocked18" value="&lt;b&gt;It stops here&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;fix it and push again&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="760.0" y="330" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="e19" value="secret found" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B91C1C;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#B91C1C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="blocked18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" value="unsafe setting" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B91C1C;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#B91C1C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="blocked18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t21" value="&lt;b&gt;then it deploys, one environment at a time&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="310.0" y="1000" width="380" height="24" as="geometry"/></mxCell>
        <mxCell id="c22" value="&lt;b&gt;DEV&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;goes out straight away&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontSize=17;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="1030" width="260" height="75" as="geometry"/></mxCell>
        <mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c24" value="&lt;b&gt;STAGE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;waits for someone to approve&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;fontSize=17;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="380" y="1030" width="260" height="75" as="geometry"/></mxCell>
        <mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;b&gt;PROD&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;waits for someone to approve&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;strokeWidth=2;fontSize=17;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="700" y="1030" width="260" height="75" as="geometry"/></mxCell>
        <mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;b&gt;Four containers, running&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;app-dev-1        app-stage-1        app-prod-1  +  app-prod-2&lt;br&gt;&lt;br&gt;each one on its own network. they cannot reach each other.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="1150" width="900" height="80" as="geometry"/></mxCell>
        <mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c22" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
