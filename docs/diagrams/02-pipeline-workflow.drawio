<mxfile host="app.diagrams.net" type="device">
  <diagram name="Actions workflow" id="pipeline-workflow">
    <mxGraphModel dx="1400" dy="2000" grid="1" gridSize="10" guides="1" tooltips="1"
                  connect="1" arrows="1" fold="1" page="1" pageScale="1"
                  pageWidth="1500" pageHeight="2120" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t" value="GitHub Actions automation &#8212; security-pipeline.yml&#10;One workflow file. Three jobs. Three self-hosted runners. Green = automatic, Amber = a person decides."
          style="text;html=1;align=left;fontSize=19;fontStyle=1;fontColor=#1F2933;"
          vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="50" as="geometry"/></mxCell>

        <!-- PHASE A -->
        <mxCell id="pa" value="PHASE A &#8212; PULL REQUEST (nothing deploys)"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#4A6FA5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fontStyle=1;"
          vertex="1" parent="1"><mxGeometry x="40" y="90" width="1420" height="470" as="geometry"/></mxCell>

        <mxCell id="a1" value="Developer edits terraform/deploy/prod/main.tf&#10;replica_count 2 &#8594; 3, opens PR #4"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF7;strokeColor=#4A6FA5;fontSize=12;"
          vertex="1" parent="1"><mxGeometry x="70" y="130" width="330" height="70" as="geometry"/></mxCell>

        <mxCell id="a2" value="JOB 1 &#8212; Secrets&#10;runs on ci-dev (lowest trust, needs no key)&#10;&#10;checkout fetch-depth: 0  &#8592; the whole history&#10;gitleaks detect --source .&#10;upload SARIF &#8594; Security tab"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F5EC;strokeColor=#2E7D32;fontSize=12;align=left;spacingLeft=10;"
          vertex="1" parent="1"><mxGeometry x="70" y="240" width="330" height="130" as="geometry"/></mxCell>

        <mxCell id="a3" value="JOB 2 &#8212; IaC matrix (fail-fast: false)&#10;three copies, one per runner"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F5EC;strokeColor=#2E7D32;fontSize=12;fontStyle=1;"
          vertex="1" parent="1"><mxGeometry x="470" y="130" width="620" height="50" as="geometry"/></mxCell>

        <mxCell id="a3d" value="IaC (dev) on ci-dev&#10;&#10;terraform fmt -check&#10;SOPS decrypt (dev age key)&#10;terraform init &#8594; deploy_dev&#10;terraform validate&#10;checkov &#8594; JSON + SARIF&#10;ai_triage.py&#10;blocking = 10"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;fontSize=11;align=left;spacingLeft=10;"
          vertex="1" parent="1"><mxGeometry x="470" y="200" width="195" height="180" as="geometry"/></mxCell>
        <mxCell id="a3s" value="IaC (stage) on ci-stage&#10;&#10;same steps&#10;stage age key&#10;deploy_stage&#10;&#10;blocking = 14"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C77700;fontSize=11;align=left;spacingLeft=10;"
          vertex="1" parent="1"><mxGeometry x="682" y="200" width="195" height="180" as="geometry"/></mxCell>
        <mxCell id="a3p" value="IaC (prod) on ci-prod&#10;&#10;same steps&#10;prod age key&#10;deploy_prod&#10;&#10;blocking = 14"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3261E;fontSize=11;align=left;spacingLeft=10;"
          vertex="1" parent="1"><mxGeometry x="895" y="200" width="195" height="180" as="geometry"/></mxCell>

        <mxCell id="a4" value="Three PR comments, one per environment&#10;plain-English triage, written pass or fail"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF7;strokeColor=#4A6FA5;fontSize=12;"
          vertex="1" parent="1"><mxGeometry x="470" y="405" width="330" height="60" as="geometry"/></mxCell>

        <mxCell id="a5" value="BRANCH PROTECTION&#10;4 required checks green&#10;+ 1 approving review&#10;+ branch up to date&#10;&#10;Merge stays BLOCKED"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontSize=12;fontStyle=1;"
          vertex="1" parent="1"><mxGeometry x="1140" y="200" width="290" height="180" as="geometry"/></mxCell>

        <mxCell id="a6" value="STEP 5 + 6 of the demo: show the red box, then merge with --admin&#10;GitHub records the override. In a real team a second engineer approves here."
          style="text;html=1;align=left;fontSize=11;fontStyle=2;fontColor=#7A4E00;"
          vertex="1" parent="1"><mxGeometry x="70" y="490" width="1370" height="40" as="geometry"/></mxCell>

        <mxCell id="ea1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#4A6FA5;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#4A6FA5;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="a1" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#4A6FA5;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="a3d" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#C77700;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="a3p" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- PHASE B -->
        <mxCell id="pb" value="PHASE B &#8212; MERGE TO main (the only path to a deploy)"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#6B4E9E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fontStyle=1;"
          vertex="1" parent="1"><mxGeometry x="40" y="580" width="1420" height="1180" as="geometry"/></mxCell>

        <mxCell id="b1" value="gh pr merge 4 --squash --admin --delete-branch&#10;&#8594; push to main fires the workflow again"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#6B4E9E;fontSize=12;fontStyle=1;"
          vertex="1" parent="1"><mxGeometry x="70" y="620" width="430" height="60" as="geometry"/></mxCell>

        <mxCell id="b2" value="Secrets + IaC x3 run again against main&#10;(about 90 seconds)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F5EC;strokeColor=#2E7D32;fontSize=12;"
          vertex="1" parent="1"><mxGeometry x="540" y="620" width="430" height="60" as="geometry"/></mxCell>

        <mxCell id="b3" value="JOB 3 &#8212; Deploy&#10;max-parallel: 1 &#8212; always dev, then stage, then prod"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#6B4E9E;fontSize=13;fontStyle=1;"
          vertex="1" parent="1"><mxGeometry x="1010" y="620" width="420" height="60" as="geometry"/></mxCell>

        <mxCell id="steps" value="EVERY deploy job runs these seven steps, on its own runner:&#10;&#10;1  checkout&#10;2  SOPS decrypt secrets.enc.yaml   &#8594; DB creds AND Proxmox API token&#10;3  terraform init (pg backend)     &#8594; schema deploy_&lt;env&gt;&#10;4  terraform plan -out=tfplan      &#8594; what will change&#10;5  terraform show -json tfplan     &#8594; the plan, as data&#10;6  policy_check.py --plan plan.json &#8594; PVE-1/3/4 against the PLAN, not the source&#10;7  terraform apply tfplan          &#8594; the exact plan that was checked, nothing else&#10;   terraform output                &#8594; container IDs and hostnames"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B4E9E;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontFamily=Courier New;"
          vertex="1" parent="1"><mxGeometry x="70" y="720" width="620" height="220" as="geometry"/></mxCell>

        <mxCell id="why" value="WHY plan &#8594; check &#8594; apply the SAVED plan&#10;&#10;Checkov has no rules for the Proxmox provider. Scanned with&#10;Checkov alone this code passes by being unrecognised.&#10;So the policy lives in scripts/policy_check.py and runs against&#10;the resolved JSON plan. Then apply is handed that same file,&#10;so what was checked is exactly what is built."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;"
          vertex="1" parent="1"><mxGeometry x="730" y="720" width="700" height="220" as="geometry"/></mxCell>

        <mxCell id="dv" value="Deploy (dev) &#8212; ci-dev&#10;&#10;NO approval. Applies the moment scans pass.&#10;&#10;Creates CT 301  app-dev-1  10.10.10.20&#10;unprivileged, start_on_boot false, protect false"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F5EC;strokeColor=#2E7D32;fontSize=12;align=left;spacingLeft=12;"
          vertex="1" parent="1"><mxGeometry x="70" y="980" width="430" height="140" as="geometry"/></mxCell>

        <mxCell id="sg" value="Deploy (stage) &#8212; ci-stage&#10;&#10;PAUSES &#8212; &quot;Waiting for review&quot;&#10;A person clicks Approve and deploy.&#10;&#10;Creates CT 311  app-stage-1  10.20.10.20&#10;start_on_boot true, protect false"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C77700;fontSize=12;align=left;spacingLeft=12;"
          vertex="1" parent="1"><mxGeometry x="540" y="980" width="430" height="140" as="geometry"/></mxCell>

        <mxCell id="pr" value="Deploy (prod) &#8212; ci-prod&#10;&#10;PAUSES &#8212; and cannot start until stage finished.&#10;A person clicks Approve and deploy.&#10;&#10;Creates CT 321 / 322 / 323  10.30.10.20/.21/.22&#10;start_on_boot true, protect TRUE"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#B3261E;fontSize=12;align=left;spacingLeft=12;"
          vertex="1" parent="1"><mxGeometry x="1000" y="980" width="430" height="140" as="geometry"/></mxCell>

        <mxCell id="gate" value="THE PROMOTION MODEL&#10;Dev goes out on its own. Stage and prod each need a person to say yes.&#10;The gate sits where the cost of being wrong changes."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontSize=13;fontStyle=1;align=center;"
          vertex="1" parent="1"><mxGeometry x="70" y="1150" width="1360" height="70" as="geometry"/></mxCell>

        <mxCell id="inst" value="SEPARATE STAGE &#8212; the application install (run from the HOST, not the runner)&#10;&#10;/root/install-app.sh &lt;env&gt;&#10;&#10;Terraform builds machines through the Proxmox API and never logs into them.&#10;The runners have no SSH key to the workloads and no route to them.&#10;Keeping install separate means rebuilding a server is not redeploying the app,&#10;and redeploying the app is not rebuilding a server."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#6B4E9E;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;"
          vertex="1" parent="1"><mxGeometry x="70" y="1250" width="660" height="200" as="geometry"/></mxCell>

        <mxCell id="inst2" value="What install-app.sh does per container, only if not already serving:&#10;&#10;1  create service account 'rapta'  &#8212; the app never runs as root&#10;2  install python3 / curl / python3-venv if missing&#10;3  copy release into releases/&lt;version&gt;  &#8212; old releases stay&#10;4  build a venv inside that release folder&#10;5  move ONE symlink: current &#8594; releases/&lt;version&gt;   &#8592; this IS the release&#10;6  install the systemd unit, pointing at 'current', never a version&#10;7  wait for /health to pass before reporting success"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B4E9E;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;"
          vertex="1" parent="1"><mxGeometry x="760" y="1250" width="670" height="200" as="geometry"/></mxCell>

        <mxCell id="ver" value="PROOF &#8212; ask each machine who it is&#10;curl -s http://10.30.10.22:8080/&#10;&#8594; {&quot;host&quot;: &quot;app-prod-3&quot;, &quot;environment&quot;: &quot;prod&quot;, &quot;version&quot;: &quot;1.1.0&quot;}&#10;Each container reads its environment from its own hostname."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F5EC;strokeColor=#2E7D32;fontSize=12;align=left;spacingLeft=12;"
          vertex="1" parent="1"><mxGeometry x="70" y="1480" width="1360" height="90" as="geometry"/></mxCell>

        <mxCell id="conc" value="CONCURRENCY + PERMISSIONS&#10;concurrency: cancel-in-progress: true  &#8212; a second push cancels the run in flight, so two applies cannot race&#10;permissions: contents: read  &#8212; the workflow token reads code and nothing else; each job adds only what it needs"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#4A6FA5;fontSize=11;align=left;spacingLeft=12;"
          vertex="1" parent="1"><mxGeometry x="70" y="1600" width="1360" height="70" as="geometry"/></mxCell>

        <mxCell id="disp" value="workflow_dispatch &#8212; re-apply ONE environment cleanly. This is the lever a live demo needs."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF7;strokeColor=#4A6FA5;fontSize=12;fontStyle=1;align=center;"
          vertex="1" parent="1"><mxGeometry x="70" y="1690" width="1360" height="50" as="geometry"/></mxCell>

        <mxCell id="eb1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6B4E9E;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6B4E9E;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2E7D32;strokeWidth=3;endArrow=block;" edge="1" parent="1" source="steps" target="dv"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#C77700;strokeWidth=3;endArrow=block;" edge="1" parent="1" source="dv" target="sg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#B3261E;strokeWidth=3;endArrow=block;" edge="1" parent="1" source="sg" target="pr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6B4E9E;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="gate" target="inst"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb7" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="inst2" target="ver"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
