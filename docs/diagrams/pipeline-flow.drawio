        <mxCell id="t2" value="&lt;b&gt;Security Pipeline &amp;#8212; control flow&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="t3" value="secure-iac-pipeline  &amp;#183;  every gate shown is implemented, run and verified" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="60" y="58" width="1000" height="26" as="geometry"/></mxCell>
        <mxCell id="zone_local4" value="LOCAL  —  THE CHEAPEST GATE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#15803D;strokeWidth=2;dashed=1;dashPattern=8 5;arcSize=4;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#15803D;spacingLeft=8;spacingTop=-22;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1180" height="170" as="geometry"/></mxCell>
        <mxCell id="dev_edit5" value="&lt;b&gt;Developer edits Terraform&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="330.0" y="140" width="460" height="60" as="geometry"/></mxCell>
        <mxCell id="precommit6" value="&lt;b&gt;pre-commit  ·  gitleaks + terraform fmt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;caught here it is never even a commit:&lt;br&gt;no rotation, no history rewrite, no incident&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="330.0" y="225" width="460" height="75" as="geometry"/></mxCell>
        <mxCell id="fixlocal7" value="&lt;b&gt;Fix locally&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;before it is&lt;br&gt;even a commit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;strokeWidth=2;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1000" y="228" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev_edit5" target="precommit6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="secret" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B91C1C;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#B91C1C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="precommit6" target="fixlocal7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="zone_g110" value="CI GATE 1  ·  SECRETS  —  RUNS FIRST AND ALONE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B91C1C;strokeWidth=2;dashed=1;dashPattern=8 5;arcSize=4;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#B91C1C;spacingLeft=8;spacingTop=-22;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="1180" height="195" as="geometry"/></mxCell>
        <mxCell id="push11" value="&lt;b&gt;Push  /  open pull request&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="330.0" y="340" width="460" height="55" as="geometry"/></mxCell>
        <mxCell id="gitleaks12" value="&lt;b&gt;gitleaks  —  entire history&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;fetch-depth: 0  ·  scans every commit ever made, not just the tip.&lt;br&gt;Without this line the scan is decorative.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="330.0" y="425" width="460" height="80" as="geometry"/></mxCell>
        <mxCell id="blocked_secret13" value="&lt;b&gt;BLOCKED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;rotate FIRST,&lt;br&gt;then rewrite&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;strokeWidth=2;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1000" y="428" width="190" height="74" as="geometry"/></mxCell>
        <mxCell id="e14" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#15803D;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#15803D;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="precommit6" target="push11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="push11" target="gitleaks12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="leak" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B91C1C;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#B91C1C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gitleaks12" target="blocked_secret13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="zone_g217" value="CI GATE 2  ·  INFRASTRUCTURE AS CODE, PER ENVIRONMENT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1D4ED8;strokeWidth=2;dashed=1;dashPattern=8 5;arcSize=4;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#1D4ED8;spacingLeft=8;spacingTop=-22;" vertex="1" parent="1"><mxGeometry x="40" y="545" width="1180" height="330" as="geometry"/></mxCell>
        <mxCell id="checkov18" value="&lt;b&gt;Checkov  ·  matrix over three environments&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="330.0" y="565" width="460" height="55" as="geometry"/></mxCell>
        <mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gitleaks12" target="checkov18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="env_dev20" value="&lt;b&gt;envs/dev&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;same code → 10 blocking&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=2;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="655" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="checkov18" target="env_dev20"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="env_stage22" value="&lt;b&gt;envs/stage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;same code → 14 blocking&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=2;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="450" y="655" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="checkov18" target="env_stage22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="env_prod24" value="&lt;b&gt;envs/prod&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;same code → 14 blocking&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=2;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="820" y="655" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="checkov18" target="env_prod24"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ai_triage26" value="&lt;b&gt;AI triage  ·  scripts/ai_triage.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;orders findings, explains each in plain English, flags false positives.&lt;br&gt;Falls back to deterministic rules when the API is unavailable.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="270.0" y="770" width="580" height="85" as="geometry"/></mxCell>
        <mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="env_dev20" target="ai_triage26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="env_stage22" target="ai_triage26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="env_prod24" target="ai_triage26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="decide30" value="&lt;b&gt;blocking findings?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="400" y="900" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ai_triage26" target="decide30"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="blocked_iac32" value="&lt;b&gt;BLOCKED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;the PR comment says&lt;br&gt;exactly what to fix&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;strokeWidth=2;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1000" y="908" width="190" height="74" as="geometry"/></mxCell>
        <mxCell id="e33" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B91C1C;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#B91C1C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="decide30" target="blocked_iac32"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="zone_deploy34" value="DEPLOY  ·  GITHUB OIDC — NO STORED CLOUD CREDENTIALS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#15803D;strokeWidth=2;dashed=1;dashPattern=8 5;arcSize=4;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#15803D;spacingLeft=8;spacingTop=-22;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="1180" height="300" as="geometry"/></mxCell>
        <mxCell id="plan35" value="&lt;b&gt;terraform plan  ·  assume role via OIDC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;short-lived token scoped to THIS repo and THIS environment.&lt;br&gt;No access key is stored anywhere in the repository.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="270.0" y="1040" width="580" height="80" as="geometry"/></mxCell>
        <mxCell id="e36" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#15803D;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#15803D;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="decide30" target="plan35"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="policy37" value="&lt;b&gt;Deploy policy gate  ·  scripts/policy_check.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;written against terraform show -json of the PLAN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="270.0" y="1150" width="580" height="60" as="geometry"/></mxCell>
        <mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="plan35" target="policy37"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="apply_dev39" value="&lt;b&gt;apply → dev&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;automatic on merge&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="1240" width="300" height="65" as="geometry"/></mxCell>
        <mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="policy37" target="apply_dev39"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="apply_stage41" value="&lt;b&gt;apply → stage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;reviewer approval&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="450" y="1240" width="300" height="65" as="geometry"/></mxCell>
        <mxCell id="e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="policy37" target="apply_stage41"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="apply_prod43" value="&lt;b&gt;apply → prod&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;reviewer approval&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="820" y="1240" width="300" height="65" as="geometry"/></mxCell>
        <mxCell id="e44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="policy37" target="apply_prod43"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="principles45" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="1350" width="1180" height="160" as="geometry"/></mxCell>
        <mxCell id="t46" value="&lt;b&gt;Four decisions this design rests on&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="65" y="1362" width="700" height="24" as="geometry"/></mxCell>
        <mxCell id="t47" value="1.   Detection is deterministic. The model explains and orders findings; it never decides pass/fail. An API outage must not become a security bypass." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="65" y="1398" width="1130" height="24" as="geometry"/></mxCell>
        <mxCell id="t48" value="2.   fetch-depth: 0 is mandatory. The default shallow clone hides exactly the case that matters — a secret committed once, then deleted." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="65" y="1424" width="1130" height="24" as="geometry"/></mxCell>
        <mxCell id="t49" value="3.   Rotate before you rewrite. Revoking takes minutes; rewriting reaches every fork, PR ref and clone. Only rotation reduces risk today." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="65" y="1450" width="1130" height="24" as="geometry"/></mxCell>
        <mxCell id="t50" value="4.   dev is allowed to be cheaper. Blocking dev on production-grade controls is how a team learns to route around the pipeline." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="65" y="1476" width="1130" height="24" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
