<mxfile host="app.diagrams.net" type="device">
  <diagram name="System architecture" id="sys-arch">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1"
                  connect="1" arrows="1" fold="1" page="1" pageScale="1"
                  pageWidth="1650" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="The Password You Already Deleted &#8212; system architecture&#10;GitHub orchestrates. Proxmox executes. No credential crosses the boundary."
          style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F2933;"
          vertex="1" parent="1"><mxGeometry x="50" y="20" width="1000" height="50" as="geometry"/></mxCell>

        <mxCell id="laptop" value="Developer laptop&#10;&#10;pre-commit: gitleaks + terraform fmt"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF7;strokeColor=#4A6FA5;fontSize=13;align=center;verticalAlign=middle;"
          vertex="1" parent="1"><mxGeometry x="50" y="90" width="300" height="70" as="geometry"/></mxCell>

        <mxCell id="gh" value="GitHub.com &#8212; ORCHESTRATION ONLY"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#4A6FA5;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=15;fontStyle=1;"
          vertex="1" parent="1"><mxGeometry x="50" y="210" width="1550" height="190" as="geometry"/></mxCell>
        <mxCell id="gh1" value="Actions&#10;schedules jobs&#10;3 self-hosted runner labels"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A6FA5;fontSize=12;"
          vertex="1" parent="1"><mxGeometry x="80" y="250" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="gh2" value="Branch protection on main&#10;4 required checks&#10;1 approving review&#10;must be up to date"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A6FA5;fontSize=12;"
          vertex="1" parent="1"><mxGeometry x="360" y="250" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="gh3" value="Environments&#10;dev / stage / prod&#10;reviewers on stage + prod&#10;= the approval pause"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A6FA5;fontSize=12;"
          vertex="1" parent="1"><mxGeometry x="640" y="250" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="gh4" value="Security tab&#10;SARIF from gitleaks&#10;and checkov-&lt;env&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A6FA5;fontSize=12;"
          vertex="1" parent="1"><mxGeometry x="920" y="250" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="gh5" value="Repository secrets&#10;ANTHROPIC_API_KEY only&#10;&#10;NO cloud credential&#10;NO deploy credential"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontSize=12;fontStyle=1;"
          vertex="1" parent="1"><mxGeometry x="1200" y="250" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="ghnote" value="If the GitHub account were compromised, an attacker could schedule jobs. Every credential that matters lives on a runner behind NAT, on a network they cannot reach."
          style="text;html=1;align=left;fontSize=11;fontColor=#7A4E00;"
          vertex="1" parent="1"><mxGeometry x="80" y="355" width="1400" height="30" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#4A6FA5;strokeWidth=2;endArrow=block;"
          edge="1" parent="1" source="laptop" target="gh"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1l" value="git push / open PR" style="edgeLabel;html=1;fontSize=11;" vertex="1" connectable="0" parent="e1">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>

        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2E7D32;strokeWidth=3;endArrow=block;dashed=0;"
          edge="1" parent="1" source="gh" target="pve"><mxGeometry relative="1" as="geometry">
          <mxPoint x="825" y="400" as="sourcePoint"/><mxPoint x="825" y="450" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e2l" value="runners poll OUTBOUND over HTTPS &#8212; nothing on the internet connects in"
          style="edgeLabel;html=1;fontSize=12;fontStyle=1;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;"
          vertex="1" connectable="0" parent="e2"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>

        <mxCell id="pve" value="Proxmox VE host &#8212; pve2 &#8212; 192.168.1.132"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F5FA;strokeColor=#6B4E9E;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=15;fontStyle=1;"
          vertex="1" parent="1"><mxGeometry x="50" y="460" width="1550" height="740" as="geometry"/></mxCell>

        <mxCell id="vmbr0" value="vmbr0 &#8212; uplink 192.168.1.0/24&#10;NAT + forward policy (runner-net.service)&#10;drops every cross-segment packet"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#6B4E9E;fontSize=12;"
          vertex="1" parent="1"><mxGeometry x="80" y="500" width="380" height="80" as="geometry"/></mxCell>

        <mxCell id="dev" value="vmbr1 &#8212; DEV &#8212; 10.10.10.0/24"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F5EC;strokeColor=#2E7D32;verticalAlign=top;align=center;spacingTop=8;fontSize=13;fontStyle=1;"
          vertex="1" parent="1"><mxGeometry x="80" y="620" width="470" height="290" as="geometry"/></mxCell>
        <mxCell id="dev1" value="ci-dev &#8212; CT 201 &#8212; .10&#10;runner label: dev&#10;holds dev age key + dev DB creds&#10;Terraform 1.5.7, gitleaks 8.30.1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;fontSize=11;"
          vertex="1" parent="1"><mxGeometry x="105" y="655" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="dev2" value="app-dev-1 &#8212; CT 301 &#8212; .20&#10;built by the pipeline&#10;replica_count = 1&#10;start_on_boot = false, protect = false"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;dashed=1;fontSize=11;"
          vertex="1" parent="1"><mxGeometry x="105" y="770" width="420" height="110" as="geometry"/></mxCell>

        <mxCell id="stg" value="vmbr2 &#8212; STAGE &#8212; 10.20.10.0/24"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C77700;verticalAlign=top;align=center;spacingTop=8;fontSize=13;fontStyle=1;"
          vertex="1" parent="1"><mxGeometry x="590" y="620" width="470" height="290" as="geometry"/></mxCell>
        <mxCell id="stg1" value="ci-stage &#8212; CT 202 &#8212; .10&#10;runner label: stage&#10;holds stage age key + stage DB creds"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C77700;fontSize=11;"
          vertex="1" parent="1"><mxGeometry x="615" y="655" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="stg2" value="app-stage-1 &#8212; CT 311 &#8212; .20&#10;built by the pipeline&#10;replica_count = 1&#10;start_on_boot = true, protect = false"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C77700;dashed=1;fontSize=11;"
          vertex="1" parent="1"><mxGeometry x="615" y="770" width="420" height="110" as="geometry"/></mxCell>

        <mxCell id="prd" value="vmbr3 &#8212; PROD &#8212; 10.30.10.0/24"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#B3261E;verticalAlign=top;align=center;spacingTop=8;fontSize=13;fontStyle=1;"
          vertex="1" parent="1"><mxGeometry x="1100" y="620" width="470" height="290" as="geometry"/></mxCell>
        <mxCell id="prd1" value="ci-prod &#8212; CT 203 &#8212; .10&#10;runner label: prod&#10;holds prod age key + prod DB creds"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3261E;fontSize=11;"
          vertex="1" parent="1"><mxGeometry x="1125" y="655" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="prd2" value="app-prod-1 / -2 / -3 &#8212; CT 321 / 322 / 323 &#8212; .20 / .21 / .22&#10;built by the pipeline&#10;replica_count = 2, becomes 3 in this demo&#10;start_on_boot = true, protect = TRUE"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3261E;dashed=1;fontSize=11;"
          vertex="1" parent="1"><mxGeometry x="1125" y="770" width="420" height="110" as="geometry"/></mxCell>

        <mxCell id="nrt" value="NO ROUTE between any two environment segments. Verified in all six directions."
          style="text;html=1;align=center;fontSize=12;fontStyle=1;fontColor=#B3261E;"
          vertex="1" parent="1"><mxGeometry x="80" y="915" width="1490" height="20" as="geometry"/></mxCell>

        <mxCell id="mgmt" value="vmbr4 &#8212; MANAGEMENT &#8212; 10.40.10.0/24"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EEF7;strokeColor=#4A6FA5;verticalAlign=top;align=center;spacingTop=8;fontSize=13;fontStyle=1;"
          vertex="1" parent="1"><mxGeometry x="490" y="960" width="670" height="200" as="geometry"/></mxCell>
        <mxCell id="mgmt1" value="tf-state &#8212; CT 204 &#8212; .10 &#8212; PostgreSQL 17&#10;&#10;tfstate_dev  / role tf_dev    / schema deploy_dev&#10;tfstate_stage / role tf_stage / schema deploy_stage&#10;tfstate_prod  / role tf_prod  / schema deploy_prod&#10;&#10;pg_hba.conf pins each role to its own /24"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A6FA5;fontSize=11;align=left;spacingLeft=12;"
          vertex="1" parent="1"><mxGeometry x="515" y="995" width="620" height="140" as="geometry"/></mxCell>

        <mxCell id="d2m" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=block;"
          edge="1" parent="1" source="dev1" target="mgmt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s2m" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#C77700;strokeWidth=2;endArrow=block;"
          edge="1" parent="1" source="stg1" target="mgmt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2m" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#B3261E;strokeWidth=2;endArrow=block;"
          edge="1" parent="1" source="prd1" target="mgmt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m2l" value="port 5432 only, own database only"
          style="text;html=1;align=center;fontSize=11;fontStyle=2;"
          vertex="1" parent="1"><mxGeometry x="600" y="938" width="450" height="20" as="geometry"/></mxCell>

        <mxCell id="api" value="Proxmox API &#8212; https://192.168.1.132:8006&#10;token per environment:&#10;terraform@pve!ci-dev / !ci-stage / !ci-prod"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#6B4E9E;fontSize=12;"
          vertex="1" parent="1"><mxGeometry x="1190" y="995" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="apil" value="Terraform calls the API and stops.&#10;It never logs into a container."
          style="text;html=1;align=center;fontSize=11;fontStyle=2;fontColor=#6B4E9E;"
          vertex="1" parent="1"><mxGeometry x="1190" y="1092" width="380" height="34" as="geometry"/></mxCell>

        <mxCell id="host" value="THE HOST does the application install: /root/install-app.sh &lt;env&gt;&#10;It has a route to every segment. The runners do not."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#6B4E9E;fontSize=12;fontStyle=1;"
          vertex="1" parent="1"><mxGeometry x="80" y="995" width="380" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
