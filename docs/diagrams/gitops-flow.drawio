<mxfile host="app.diagrams.net" type="device">
  <diagram name="GitOps flow" id="GitOps-flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1"
                  connect="1" arrows="1" fold="1" page="1" pageScale="1"
                  pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t2" value="&lt;b&gt;GitOps flow &amp;#8212; from a code change to four running containers&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=23;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1180" height="40" as="geometry"/></mxCell>
        <mxCell id="t3" value="every step below is a real command; the numbers match the runbook" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1180" height="24" as="geometry"/></mxCell>
        <mxCell id="z_local4" value="ON YOUR LAPTOP  —  the cheapest place to catch anything" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#15803D;strokeWidth=2;dashed=1;dashPattern=8 5;arcSize=4;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#15803D;spacingLeft=8;spacingTop=-22;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1180" height="300" as="geometry"/></mxCell>
        <mxCell id="s15" value="&lt;b&gt;1.  git clone&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;git clone git@github.com:georgejpark/secure-iac-pipeline.git&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="360.0" y="130" width="520" height="55" as="geometry"/></mxCell>
        <mxCell id="s26" value="&lt;b&gt;2.  git checkout -b&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;feat/&amp;amp;lt;ticket&amp;amp;gt;-short-description&lt;br&gt;never commit to main directly&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="360.0" y="205" width="520" height="62" as="geometry"/></mxCell>
        <mxCell id="s37" value="&lt;b&gt;3.  edit terraform/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;add or change a resource, module or variable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="360.0" y="287" width="520" height="55" as="geometry"/></mxCell>
        <mxCell id="s48" value="&lt;b&gt;4.  git commit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;pre-commit fires HERE: gitleaks + terraform fmt&lt;br&gt;a secret caught now never becomes a commit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="360.0" y="362" width="520" height="62" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s15" target="s26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s26" target="s37"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s37" target="s48"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="local_block12" value="&lt;b&gt;commit REFUSED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;fix it locally, nothing&lt;br&gt;ever reaches GitHub&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;strokeWidth=2;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1000" y="365" width="200" height="58" as="geometry"/></mxCell>
        <mxCell id="e13" value="secret found" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B91C1C;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#B91C1C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s48" target="local_block12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="z_pr14" value="GITHUB  —  the pull request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1D4ED8;strokeWidth=2;dashed=1;dashPattern=8 5;arcSize=4;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#1D4ED8;spacingLeft=8;spacingTop=-22;" vertex="1" parent="1"><mxGeometry x="40" y="445" width="1180" height="175" as="geometry"/></mxCell>
        <mxCell id="s515" value="&lt;b&gt;5.  git push -u origin&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;git push -u origin feat/&amp;amp;lt;ticket&amp;amp;gt;-short-description&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="360.0" y="465" width="520" height="55" as="geometry"/></mxCell>
        <mxCell id="s616" value="&lt;b&gt;6.  gh pr create&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;gh pr create --base main --title &quot;...&quot; --body &quot;...&quot;&lt;br&gt;opening the PR is what starts the pipeline&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="360.0" y="545" width="520" height="62" as="geometry"/></mxCell>
        <mxCell id="e17" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#15803D;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#15803D;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s48" target="s515"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s515" target="s616"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="z_ci19" value="CI  —  runs on YOUR runners, one per environment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B45309;strokeWidth=2;dashed=1;dashPattern=8 5;arcSize=4;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#B45309;spacingLeft=8;spacingTop=-22;" vertex="1" parent="1"><mxGeometry x="40" y="645" width="1180" height="350" as="geometry"/></mxCell>
        <mxCell id="s720" value="&lt;b&gt;7.  gitleaks — full history&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;fetch-depth: 0 — scans every commit ever made.&lt;br&gt;Without it the scan is decorative.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="360.0" y="665" width="520" height="62" as="geometry"/></mxCell>
        <mxCell id="pr_leak21" value="&lt;b&gt;PR BLOCKED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;rotate FIRST,&lt;br&gt;then rewrite history&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;strokeWidth=2;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1000" y="668" width="200" height="58" as="geometry"/></mxCell>
        <mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s616" target="s720"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" value="leak" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B91C1C;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#B91C1C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s720" target="pr_leak21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s824" value="&lt;b&gt;8.  checkov — dev, stage and prod in parallel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;same code, scanned three times against three policy sets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="360.0" y="750" width="520" height="55" as="geometry"/></mxCell>
        <mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s720" target="s824"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_dev26" value="&lt;b&gt;terraform/envs/dev&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;10 blocking&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=2;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="830" width="300" height="55" as="geometry"/></mxCell>
        <mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s824" target="e_dev26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_stage28" value="&lt;b&gt;terraform/envs/stage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;14 blocking&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=2;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="450" y="830" width="300" height="55" as="geometry"/></mxCell>
        <mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s824" target="e_stage28"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_prod30" value="&lt;b&gt;terraform/envs/prod&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;14 blocking&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B91C1C;strokeWidth=2;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="820" y="830" width="300" height="55" as="geometry"/></mxCell>
        <mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s824" target="e_prod30"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s932" value="&lt;b&gt;9.  AI triage → a plain-English PR comment&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;orders the findings, explains each one, flags likely false positives.&lt;br&gt;It NEVER decides pass/fail — no API key and the gate behaves identically.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="320.0" y="905" width="600" height="68" as="geometry"/></mxCell>
        <mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="e_dev26" target="s932"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="e_stage28" target="s932"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="e_prod30" target="s932"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="gate36" value="&lt;b&gt;blocking findings?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="450" y="1020" width="340" height="86" as="geometry"/></mxCell>
        <mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s932" target="gate36"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pr_block38" value="&lt;b&gt;PR BLOCKED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;fix, commit, push —&lt;br&gt;the pipeline re-runs&lt;br&gt;on the same PR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;strokeWidth=2;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1000" y="1030" width="200" height="66" as="geometry"/></mxCell>
        <mxCell id="e39" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B91C1C;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#B91C1C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gate36" target="pr_block38"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="z_review40" value="REVIEW  —  a human decision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6D28D9;strokeWidth=2;dashed=1;dashPattern=8 5;arcSize=4;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#6D28D9;spacingLeft=8;spacingTop=-22;" vertex="1" parent="1"><mxGeometry x="40" y="1130" width="1180" height="175" as="geometry"/></mxCell>
        <mxCell id="s1041" value="&lt;b&gt;10.  reviewer approves the PR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;branch protection on main: 1 approval + 4 status checks.&lt;br&gt;Until then the PR reads BLOCKED / REVIEW_REQUIRED.&lt;br&gt;GitHub refuses self-approval outright.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EFFE;strokeColor=#6D28D9;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="360.0" y="1150" width="520" height="68" as="geometry"/></mxCell>
        <mxCell id="s1142" value="&lt;b&gt;11.  merge to main&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;squash merge; the branch is deleted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EFFE;strokeColor=#6D28D9;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="360.0" y="1230" width="520" height="55" as="geometry"/></mxCell>
        <mxCell id="e43" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#15803D;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#15803D;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gate36" target="s1041"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1041" target="s1142"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="z_deploy45" value="DEPLOY  —  main is the only branch that deploys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0F766E;strokeWidth=2;dashed=1;dashPattern=8 5;arcSize=4;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#0F766E;spacingLeft=8;spacingTop=-22;" vertex="1" parent="1"><mxGeometry x="40" y="1330" width="1180" height="430" as="geometry"/></mxCell>
        <mxCell id="s1246" value="&lt;b&gt;12.  merge triggers the deploy job&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;one job per environment, max-parallel 1: dev, then stage, then prod&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="360.0" y="1350" width="520" height="62" as="geometry"/></mxCell>
        <mxCell id="e47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1142" target="s1246"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_dev48" value="&lt;b&gt;dev&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;applies automatically&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="1435" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="e49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1246" target="d_dev48"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_stage50" value="&lt;b&gt;stage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;REVIEWER must approve&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="450" y="1435" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="e51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1246" target="d_stage50"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_prod52" value="&lt;b&gt;prod&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;REVIEWER must approve&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="820" y="1435" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="e53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1246" target="d_prod52"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s1354" value="&lt;b&gt;13.  inside each deploy job&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;sops --decrypt   → the age key exists only on THIS environment's runner&lt;br&gt;terraform init   → state from THIS environment's postgres database&lt;br&gt;terraform plan   → policy_check.py runs against the PLAN&lt;br&gt;terraform apply  → LXC containers on Proxmox&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="320.0" y="1520" width="600" height="100" as="geometry"/></mxCell>
        <mxCell id="e55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_dev48" target="s1354"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_stage50" target="s1354"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_prod52" target="s1354"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s1458" value="&lt;b&gt;14.  ansible installs the application&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;python http.server under systemd — no Docker, no Kubernetes.&lt;br&gt;release dir + symlink flip, so rollback is a symlink change.&lt;br&gt;The healthcheck asserts the VERSION, not just liveness.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="320.0" y="1640" width="600" height="80" as="geometry"/></mxCell>
        <mxCell id="e59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#94A3B8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1354" target="s1458"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="result_panel60" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="1785" width="1180" height="70" as="geometry"/></mxCell>
        <mxCell id="t61" value="&lt;b&gt;What is running when this finishes&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="70" y="1795" width="400" height="22" as="geometry"/></mxCell>
